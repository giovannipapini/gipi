{
  "name": "@giovannipapini/gipi-statusbar",
  "version": "0.1.0",
  "description": "Custom pi footer with git status, context usage, cost and model info",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giovannipapini/gipi.git",
    "directory": "packages/gipi-statusbar"
  },
  "bugs": "https://github.com/giovannipapini/gipi/issues",
  "homepage": "https://github.com/giovannipapini/gipi/tree/main/packages/gipi-statusbar#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "node -e \"process.env.CI === 'true' || (console.error('publish only from CI'), process.exit(1))\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
