{
  "name": "@giovannipapini/gipi-namesession",
  "version": "0.1.1",
  "description": "Names sessions at t0 (π · <project>) and auto-renames them via the LLM",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/giovannipapini/gipi.git",
    "directory": "pi-extensions/gipi-namesession"
  },
  "bugs": "https://github.com/giovannipapini/gipi/issues",
  "homepage": "https://github.com/giovannipapini/gipi/tree/main/pi-extensions/gipi-namesession#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepublishOnly": "node -e \"process.env.CI === 'true' || (console.error('publish only from CI'), process.exit(1))\""
  },
  "peerDependencies": {
    "typebox": "*"
  }
}
