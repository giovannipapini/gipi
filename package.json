{
  "name": "gipi",
  "version": "1.0.0",
  "private": true,
  "description": "Custom pi-agent extensions and themes",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": "github:giovannipapini/gipi",
  "bugs": "https://github.com/giovannipapini/gipi/issues",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "type": "module",
  "files": [
    "extensions/",
    "themes/"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "preinstall": "node -e \"process.exit(process.env.CI ? 0 : 1)\" || echo '⚠️  Use pnpm install, not npm install' && false"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-agent-core": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@earendil-works/pi-tui": "^0.80.3",
    "@types/node": "^22",
    "typebox": "^1.1.38",
    "typescript": "^5.7"
  }
}
