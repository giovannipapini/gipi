{
  "name": "gipi",
  "version": "0.0.0",
  "private": true,
  "description": "pi extensions and themes \u2014 one publishable package per extension",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": "github:giovannipapini/gipi",
  "bugs": "https://github.com/giovannipapini/gipi/issues",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./packages/*/index.ts"
    ],
    "themes": [
      "./packages/gipi-themes/themes/*.json"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm build && pnpm pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26",
    "esbuild": "^0.25.10",
    "execa": "^9.6.1",
    "nanoid": "^5.1.16",
    "typebox": "^1.3.8",
    "typescript": "^5.7",
    "zod": "^4.4.3"
  }
}
