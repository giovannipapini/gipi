# ── pnpm security hardening ──────────────────────────────────────────
# Sources:
#   OSSF Best Practices for Open Source Developers
#   OpenJS Foundation Security WG — Secure Releases Guide 2.0
#   OWASP NPM Security Cheat Sheet
#   lirantal/npm-security-best-practices

# Block lifecycle scripts (postinstall, preinstall, etc.) from all
# third-party packages. Attackers routinely use postinstall scripts for
# code execution during installation (event-stream, Shai-Hulud, Nx).
ignore-scripts=true

# Block git-sourced dependencies (git+ssh://, git+https://, etc.).
# Git deps bypass registry security controls — no malware scanning,
# no provenance checks, no signature verification, and can ship their
# own .npmrc that re-enables scripts. (npm >= 11.10.0)
allow-git=none

# Required: pi core types must be visible to TypeScript for IDE
# resolution. This reduces isolation but is needed for this project.
shamefully-hoist=true

# Don't auto-install peer deps — pi bundles them at runtime.
auto-install-peers=false
strict-peer-dependencies=false
